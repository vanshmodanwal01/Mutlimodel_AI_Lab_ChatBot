# ==============================================================================
# MindBridge AI Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=8501

# AI Model Provider
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Database Configuration
# Primary: MySQL database URL format:
# mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/mindbridge_db
# Set to true to automatically fallback to sqlite:///./mindbridge.db if MySQL is unavailable
DB_AUTO_FALLBACK_SQLITE=true

# Storage and Upload Limits
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=10

# Security and Guardrails
RATE_LIMIT_PER_MINUTE=60
ENABLE_SAFETY_GUARDRAILS=true
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501", "http://localhost:3000"]
